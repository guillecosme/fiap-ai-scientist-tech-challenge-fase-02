# Variaveis de ambiente da pipeline. Copie para .env e escolha um dos modos.
# Os scripts (make local / make ls-run / make aws-run) carregam este arquivo.

# ----------------------------------------------------------------------------
# Modo local (filesystem): mais rapido, sem nuvem. Camadas em Parquet sob data/.
# ----------------------------------------------------------------------------
STORAGE_BACKEND=local
DATA_ROOT=data

# ----------------------------------------------------------------------------
# Modo LocalStack (S3 emulado): exercita o caminho de nuvem sem custo nem conta.
# Descomente e comente o bloco local acima.
# ----------------------------------------------------------------------------
# STORAGE_BACKEND=s3
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# BRONZE_BUCKET=<saida terraform: bucket bronze>
# SILVER_BUCKET=<saida terraform: bucket silver>
# GOLD_BUCKET=<saida terraform: bucket gold>
# SEEDS_DIR=s3a://<bucket bronze>/_seeds

# ----------------------------------------------------------------------------
# Modo AWS real: sem AWS_ENDPOINT_URL (usa o endpoint padrao de cada servico).
# Credenciais via aws configure, SSO ou variaveis de ambiente.
# ----------------------------------------------------------------------------
# STORAGE_BACKEND=s3
# AWS_REGION=us-east-1
# BRONZE_BUCKET=<saida terraform: bucket bronze>
# SILVER_BUCKET=<saida terraform: bucket silver>
# GOLD_BUCKET=<saida terraform: bucket gold>
# SEEDS_DIR=s3a://<bucket bronze>/_seeds

# ----------------------------------------------------------------------------
# Opcionais
# ----------------------------------------------------------------------------
# Ingestao direto da Base dos Dados (BigQuery, 1 TB/mes gratis). Sem isso, usa data/seeds.
# BD_BILLING_PROJECT_ID=seu-projeto-gcp

# Publica metricas no CloudWatch quando true (no modo local fica false e so imprime).
# MONITORING_ENABLED=false
